{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "document-window",
  "description": "Document windows: reading, navigation, menus and window chrome.",
  "windows": ["doc-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-take-window-init",
    "allow-take-pending-opens",
    "allow-window-ready",
    "allow-registry-update",
    "allow-perf-mark",
    "allow-toolbar-double-click",
    "allow-start-window-drag",
    "allow-close-window",
    "allow-new-window",
    "allow-open-settings",
    "allow-read-document",
    "allow-resolve-link",
    "allow-allow-images",
    "allow-image-data-urls",
    "allow-list-folder",
    "allow-open-dropped",
    "allow-open-granted",
    "allow-show-open-panel",
    "allow-locate-file",
    "allow-move-tab-to-new-window",
    "allow-merge-windows",
    "allow-list-open-documents",
    "allow-reveal-in-finder",
    "allow-open-external",
    "allow-open-in-editor",
    "allow-popup-menu",
    "allow-popup-path-menu",
    "allow-print-window",
    "allow-export-html",
    "allow-copy-to-clipboard",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-recents",
    "allow-clear-recents",
    "allow-get-reading-position",
    "allow-save-reading-position",
    "allow-list-themes",
    "allow-default-app-status",
    "allow-make-default-app",
    "allow-dismiss-default-app-banner"
  ]
}
